{
  "name": "fly21-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "start": "NODE_ENV=production bun server/index.ts",
    "build": "bun run build.ts",
